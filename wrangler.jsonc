{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terminal-manager-aliprimera",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/server/server.js",
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "tail_sampling_rate": 1
  },
  "headers": [
    {
      "pattern": "/*",
      "headers": {
        "Content-Security-Policy": "script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co"
      }
    }
  ],
  "vars": {
    "VITE_SUPABASE_URL": "https://yjfbyziwmwjrulcbuenn.supabase.co"
  }
}